{
	"name": "@keenmate/svelte-wysiwyg-v5",
	"version": "2.0.0-rc01",
	"description": "Svelte 5 WYSIWYG editor component (Jodit-based)",
	"type": "module",
	"main": "./dist/svelte-wysiwyg.umd.js",
	"module": "./dist/svelte-wysiwyg.js",
	"svelte": "./src/index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"svelte": "./src/index.js",
			"import": "./dist/svelte-wysiwyg.js",
			"require": "./dist/svelte-wysiwyg.umd.js",
			"default": "./dist/svelte-wysiwyg.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"./dist/svelte-wysiwyg.js",
		"./dist/svelte-wysiwyg.umd.js"
	],
	"files": [
		"dist",
		"src",
		"index.d.ts"
	],
	"scripts": {
		"dev": "vite --port 12500",
		"build": "npm run clean:dist && vite build",
		"preview": "vite preview",
		"clean": "rimraf dist --glob \"*.tgz\"",
		"clean:dist": "rimraf dist"
	},
	"keywords": [
		"wysiwyg",
		"rich text",
		"editor",
		"html",
		"contentEditable",
		"editing",
		"svelte",
		"svelte.js",
		"svelte component",
		"svelte5 component",
		"svelte5",
		"jodit",
		"keenmate"
	],
	"author": "KeenMate",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KeenMate/svelte-wysiwyg.git"
	},
	"bugs": {
		"url": "https://github.com/KeenMate/svelte-wysiwyg/issues"
	},
	"homepage": "https://github.com/KeenMate/svelte-wysiwyg#readme",
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"rimraf": "^5.0.5",
		"svelte": "^5.16.0",
		"vite": "^6.0.0"
	},
	"peerDependencies": {
		"jodit": "^4.0.0",
		"svelte": "^5.0.0"
	}
}
